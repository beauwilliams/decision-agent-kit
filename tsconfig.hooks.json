{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "types": [],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "claude-code": [
        "./.claude-plugin/types/claude-code/index.d.ts",
        "./types/claude-code/index.d.ts"
      ]
    }
  },
  "include": ["hooks", "src", ".claude-plugin/types/claude-code/index.d.ts"]
}
